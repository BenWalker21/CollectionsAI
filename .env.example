# Postgres connection string (Railway, Render, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/ar_assistant"

# Clerk (from dashboard.clerk.com -> your app -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Webhooks -> your endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# QuickBooks Online (from your app's "Keys and credentials" page in the
# Intuit Developer Portal -> Development tab). QUICKBOOKS_REDIRECT_URI must
# exactly match a Redirect URI registered there.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Encrypts stored Integration tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
